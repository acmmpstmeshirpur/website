# ACM Student Chapter, MPSTME Shirpur: Apache settings for cPanel hosting.
# This file is copied into dist/ by the build. Upload it with the site.

Options -Indexes
DirectoryIndex index.html index.php

# The GitHub deploy keeps its list of uploaded files here; it is not for visitors.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# --- Addresses ---
# One folder answers two addresses:
#   mpstmeshirpur.acm.org (and www.)  the public site; /admin does not exist here.
#   mpstmeshirpur.hosting.acm.org     the committee's address: its front page opens
#                                     cPanel, /admin/ is the events admin, and any
#                                     other page is sent to the public site.
# Redirects are 302 (temporary) so browsers do not remember them for good.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # cPanel's SSL certificate checks must keep working on every address.
  RewriteRule ^\.well-known/ - [L]

  # Always HTTPS (the admin login must never travel unencrypted).
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Public addresses: no admin page.
  RewriteCond %{HTTP_HOST} !^mpstmeshirpur\.hosting\.acm\.org$ [NC]
  RewriteRule ^admin(/|$) - [R=404,L]

  # Hosting address: front page opens cPanel.
  RewriteCond %{HTTP_HOST} ^mpstmeshirpur\.hosting\.acm\.org$ [NC]
  RewriteRule ^$ https://mpstmeshirpur.hosting.acm.org:2083/ [R=302,L]

  # Hosting address: everything except the admin page goes to the public site.
  RewriteCond %{HTTP_HOST} ^mpstmeshirpur\.hosting\.acm\.org$ [NC]
  RewriteCond %{REQUEST_URI} !^/admin(/|$)
  RewriteRule ^(.*)$ https://mpstmeshirpur.acm.org/$1 [R=302,L]
</IfModule>

# --- Correct types for modern assets ---
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Caching ---
# Files in /static/ have content hashes in their names, so they can be cached for a year.
# HTML and data/upcoming.json are always revalidated so visitors see changes straight away.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
    # Always send the full page (about 2 kB) instead of "304 Not Modified".
    # Date checks are unreliable here: an earlier upload stamped files with a
    # future time, so browsers holding that date were told nothing had changed.
    RequestHeader unset If-Modified-Since
    RequestHeader unset If-None-Match
    Header unset Last-Modified
    Header unset ETag
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Two static pages (index.html and upcoming.html) with #section links, so no rewrite rules are needed.
